# Generated artefacts. The "Build ZIM and PDF" workflow produces these on every
# push; download them from the Actions run or from a v* Release instead of
# committing them. The Markdown file stays the single source of truth.
europe/*/*.pdf
europe/*/*.zim
africa/*/*.pdf
africa/*/*.zim

# Source material that is deliberately kept in the repository.
!europe/*/reference/*.pdf

# Build leftovers
*.tmp
*.html
!*/reference/*.html
